{
  "name": "nexus-os",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dataconnect:generate": "npx --yes firebase-tools@latest dataconnect:sdk:generate --project nexus-96795",
    "dataconnect:diff": "npx --yes firebase-tools@latest dataconnect:sql:diff nexus-core --project nexus-96795",
    "dataconnect:migrate": "npx --yes firebase-tools@latest dataconnect:sql:migrate --force nexus-core --project nexus-96795",
    "dataconnect:deploy": "npx --yes firebase-tools@latest deploy --only dataconnect --project nexus-96795"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "tsx": "^4.21.0"
  }
}
