{
  "name": "nexus-os",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dataconnect:generate": "npx --yes firebase-tools@latest dataconnect:sdk:generate --project nexus-96795",
    "dataconnect:diff": "npx --yes firebase-tools@latest dataconnect:sql:diff --service nexus-core --location us-east4 --project nexus-96795",
    "dataconnect:migrate": "npx --yes firebase-tools@latest dataconnect:sql:migrate --service nexus-core --location us-east4 --force --project nexus-96795",
    "dataconnect:deploy": "npx --yes firebase-tools@latest deploy --only dataconnect --project nexus-96795",
    "dataconnect:cloud-shell": "bash scripts/deploy-dataconnect-cloud-shell.sh",
    "ai:deploy": "bash scripts/deploy-nexus-ai.sh",
    "build:native": "node scripts/build-native.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "firebase": "12.19.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "tsx": "^4.21.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
