# NEXUS server-only environment variables
# Never expose these values with NEXT_PUBLIC_ prefixes.

OPENAI_API_KEY=
# Optional legacy/server fallback. Defaults to gpt-6-luna.
OPENAI_MODEL=gpt-6-luna

# Firebase Authentication UID allowed to use the server-side AI billing key.
# Find your UID in NEXUS → System → Developer after signing in.
NEXUS_OWNER_UID=

# NEXUS Voice / Realtime. Optional until voice-to-voice is enabled.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Controlled data cutover. Keep "firestore" until SQL Connect is deployed and verified.
# Allowed: firestore | shadow-sql | sql-read | sql
NEXT_PUBLIC_NEXUS_DATA_MODE=firestore
