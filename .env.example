# NEXUS server-only environment variables
# Never expose these values with NEXT_PUBLIC_ prefixes.

OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-terra.
OPENAI_MODEL=gpt-5.6-terra

# Firebase Authentication UID allowed to use the server-side AI billing key.
# Find your UID in NEXUS → System → Developer after signing in.
NEXUS_OWNER_UID=
